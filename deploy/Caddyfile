{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	# Vite fingerprints the bundles. Textures and models keep their names across releases, so they are revalidated
	# by ETag on every visit: a stale atlas next to new code would show the wrong leaves
	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@assets path /assets/tex/* /assets/glb/* /assets/models/* /assets/foliage/* /assets/stamps/* /assets/lm/* /basis/*
	header @assets Cache-Control "no-cache"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	respond /healthz "utsuroi-ok" 200
	file_server
}
